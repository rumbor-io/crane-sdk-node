{
  "name": "@rumbor/memory-sdk",
  "version": "0.1.0",
  "description": "Provider-neutral Node.js SDK for Rumbor Memory.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rumbor-io/rumbor-memory.git",
    "directory": "packages/sdk-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "generate": "openapi-typescript ../../openapi/rumbor-memory.yaml -o src/generated/schema.d.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
